@prefix hw2: <http://taica.course/hw2/ontology#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


# TODO: declare hw2:FeasibleEdgeShape, a sh:NodeShape targeting hw2:Edge, with:
#   F1: obstacle clearance
#   F2: restricted zones
#   F3: personal space

hw2:FeasibleEdgeShape
    a sh:NodeShape ;
    sh:targetClass hw2:Edge ;

    # F1
    sh:property [
        sh:path hw2:obstacleClearance ;
        sh:minCount 1 ;
        sh:datatype xsd:double ;
        sh:minInclusive "0.15"^^xsd:double ;
    ] ;

    # F2
    sh:property [
        sh:path hw2:entersRestrictedZone ;
        sh:node [
            sh:property  [
                sh:path hw2:containsGoal;
                sh:hasValue true ;
            ]
        ] ;
    ] ;

    # F3
    sh:property [
        sh:path hw2:entersPersonalSpace ;
        sh:maxCount 0
    ] .